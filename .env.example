# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/tutorlink?retryWrites=true&w=majority

# JWT (minimo 32 caracteres cada uno)
JWT_ACCESS_SECRET=cambia_este_secreto_por_uno_de_al_menos_32_caracteres
JWT_REFRESH_SECRET=cambia_este_otro_secreto_por_uno_de_al_menos_32_caracteres
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Servidor
PORT=3001
NODE_ENV=development
BCRYPT_ROUNDS=12

# CORS (origenes permitidos separados por coma; usa * solo en desarrollo)
CORS_ORIGIN=http://localhost:5173

# Verificacion institucional automatica
AUTO_VERIFY=true
INSTITUTIONAL_EMAIL_DOMAINS=uniautonoma.edu.co
VERIFY_REQUIRE_ACTIVE_ACCOUNT=true
VERIFY_REQUIRE_PROVIDER_PROFILE=true
VERIFY_MIN_CATEGORIES=1
VERIFY_MIN_PORTFOLIO_WORKS=1
